[gd_resource type="Resource" script_class="PotionData" load_steps=7 format=3]

[ext_resource type="Script" path="res://Data/Potions/potion_data.gd" id="1_potion"]
[ext_resource type="Script" path="res://Systems/Combat/effect_action.gd" id="2_action"]
[ext_resource type="Script" path="res://Systems/Combat/heal_effect_action.gd" id="3_heal"]
[ext_resource type="Texture2D" path="res://Assets/Pickups/29.png" id="4_inventory"]
[ext_resource type="Texture2D" path="res://Assets/UI/Shop/Items/Potions/health.png" id="5_shop"]

[sub_resource type="Resource" id="HealAction"]
script = ExtResource("3_heal")
amount = 1

[resource]
script = ExtResource("1_potion")
