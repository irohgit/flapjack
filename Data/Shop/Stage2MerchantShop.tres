[gd_resource type="Resource" script_class="ShopData" format=3]

[ext_resource type="Script" path="res://Data/Shop/shop_data.gd" id="1_shop"]
[ext_resource type="Script" path="res://Data/Shop/shop_offer_data.gd" id="2_offer"]
[ext_resource type="Resource" path="res://Data/Pickups/HomingCannonPickup.tres" id="3_homing"]
[ext_resource type="Resource" path="res://Data/Pickups/PlasmaAugmentPickup.tres" id="4_plasma"]
[ext_resource type="Resource" path="res://Data/Pickups/FireballAugmentPickup.tres" id="5_fire"]
[ext_resource type="Resource" path="res://Data/Pickups/MagnetAugmentPickup.tres" id="6_magnet"]

[sub_resource type="Resource" id="Offer_homing"]
script = ExtResource("2_offer")
pickup = ExtResource("3_homing")
price_override = 230
rarity_override = "RARE"

[sub_resource type="Resource" id="Offer_plasma"]
script = ExtResource("2_offer")
pickup = ExtResource("4_plasma")
price_override = 210
rarity_override = "RARE"

[sub_resource type="Resource" id="Offer_fire"]
script = ExtResource("2_offer")
pickup = ExtResource("5_fire")
price_override = 210
rarity_override = "UNCOMMON"

[sub_resource type="Resource" id="Offer_magnet"]
script = ExtResource("2_offer")
pickup = ExtResource("6_magnet")
price_override = 180
rarity_override = "UNCOMMON"

[resource]
script = ExtResource("1_shop")
min_offers = 3
max_offers = 4
offer_pool = Array[ExtResource("2_offer")]([SubResource("Offer_homing"), SubResource("Offer_plasma"), SubResource("Offer_fire"), SubResource("Offer_magnet")])
