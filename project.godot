[layer_names]

2d_render/layer_1="player"
2d_render/layer_2="enemy"
2d_render/layer_3="player_bullet"
2d_render/layer_4="enemy_bullet"
2d_render/layer_5="pickup"
2d_render/defaults/default_clear_color=Color(0.6053508, 0.72031677, 0.94324833, 1)
2d_render/size/viewport_height=1080

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.6053508, 0.72031677, 0.94324833, 1)
2d/snap/snap_2d_transforms_to_pixel=true
