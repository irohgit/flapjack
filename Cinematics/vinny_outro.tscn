[sub_resource type="Resource" id="Resource_r00uc"]
script = ExtResource("2_lyw8r")
speaker = "Vinny Tanqueray"
text = "Vinny Tanqueray at your service.  I am grateful for the assistance. A Tanqueray never forgets his debts. Except for Uncle Johnny Tanqueray. Don’t ever let him borrow money from you."
portrait = ExtResource("3_t5hk1")
side = 1
metadata/_custom_type_script = "uid://1rcqoqlqlw40"

[sub_resource type="Resource" id="Resource_vvian"]
script = ExtResource("2_lyw8r")
speaker = "Jack"
text = "Don’t mention it. So..."
portrait = ExtResource("4_6277w")
metadata/_custom_type_script = "uid://1rcqoqlqlw40"

[sub_resource type="Resource" id="Resource_4s0x6"]
script = ExtResource("2_lyw8r")
speaker = "Vinny"
text = "hold on I think it’s in here... AH yes here we go and here you go.  It’ll help protect your ship from those pesky pirate cannons. "
portrait = ExtResource("5_w6fx2")
side = 1
metadata/_custom_type_script = "uid://1rcqoqlqlw40"

[sub_resource type="Resource" id="Resource_5q10e"]
script = ExtResource("2_lyw8r")
speaker = "Jack"
text = "Much obliged, Vinny. Welcome aboard. And what do you do?"
portrait = ExtResource("6_euksj")
metadata/_custom_type_script = "uid://1rcqoqlqlw40"

[sub_resource type="Resource" id="Resource_fxiy3"]
script = ExtResource("2_lyw8r")
speaker = "Vinny"
text = "Splendid! I am an Alchemist extraordinaire. Now, pray tell, what adventure are we off to, shipmate?"
portrait = ExtResource("3_t5hk1")
side = 1
metadata/_custom_type_script = "uid://1rcqoqlqlw40"

[sub_resource type="Resource" id="Resource_wlkg1"]
script = ExtResource("2_lyw8r")
speaker = "Jack"
text = "We’re saving the princess. Blackbeard’s kidnapped her."
portrait = ExtResource("7_t4vkc")
metadata/_custom_type_script = "uid://1rcqoqlqlw40"

[sub_resource type="Resource" id="Resource_kkdui"]
script = ExtResource("2_lyw8r")
speaker = "Vinny"
text = "Ah...Blackbeard"
